# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

# Neon "dev" branch connection string (Neon console → Connect → psycopg).
# Note the "+psycopg" driver prefix and sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require

# Used ONLY by pytest. Point at the Neon dev branch — NEVER production (main).
# Each test runs in a transaction that is rolled back. If unset, DB tests are skipped.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me

# Single-user login
APP_USERNAME=me
# Generate with: python scripts/hash_password.py  (paste the whole printed line)
APP_PASSWORD_HASH=change-me

# Vite dev server locally; your Vercel URL in production
# Comma-separate several: http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
